# Server Environment Configuration Example
PORT=5000
NODE_ENV=development

# Database Configuration
# Set USE_LOCAL_DB=false for MongoDB (production / standard setup)
# Set USE_LOCAL_DB=true ONLY for local development without MongoDB (uses a JSON file database for local dev only)
USE_LOCAL_DB=false
MONGO_URI=mongodb://localhost:27017/ecollect-go

# Authentication & Security
JWT_SECRET=your_secure_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Demo Seeding (Disabled by default in production)
SEED_DEMO=false
DEMO_ADMIN_PASSWORD=your_secure_admin_password
DEMO_USER_PASSWORD=your_secure_demo_password
